# Local paths are relative to backend/. Defaults work without an .env file.
PORT=3000
DATA_DIR=./data
DATABASE_PATH=./data/shop.sqlite
UPLOAD_DIR=./uploads

# Optional: otherwise generated once at data/jwt-secret and reused on restart.
# JWT_SECRET=

# Optional: absolute public backend origin when images use a separate domain.
# PUBLIC_API_URL=https://api.example.com

# Optional: enables Omise online payment endpoints. Manual slip upload needs no key.
# OMISE_SECRET_KEY=
