meta {
  name: UploadPaymentGateway
  type: http
  seq: 2
}

post {
  url: http://localhost:3000/uploadPaymentGateway
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Bank Transfer QR",
    "imageBase64": "data:image/webp;base64,",
    "bankName": "Example Bank",
    "accountNumber": "123-456-7890",
    "accountName": "ShopMart Store",
    "isActive": true
  }
}

settings {
  encodeUrl: false
  timeout: 0
}
